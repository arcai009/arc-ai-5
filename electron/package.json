{
  "name": "arc-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "ai.arcai.desktop",
    "productName": "Arc AI",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
