# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://arc:arc_dev_password@localhost:5432/arc_ai?schema=public"

# --- Redis (matches docker-compose.yml defaults) ---
REDIS_URL="redis://localhost:6379"

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# From Clerk Dashboard > Webhooks > your endpoint > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/chat"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/chat"

# --- Signup credit grant ---
SIGNUP_FREE_CREDITS="1000"

# --- LLM providers (server-side only, never exposed to the client) ---
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# --- E2B sandbox (https://e2b.dev) ---
E2B_API_KEY="e2b_..."

# --- Dodo Payments (https://app.dodopayments.com) ---
DODO_PAYMENTS_API_KEY="..."
# From Dodo Dashboard > Webhooks > your endpoint > Signing Secret
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Product ids for your Pro subscription and top-up pack, created in the Dodo dashboard
DODO_PRO_PRODUCT_ID="pdt_..."
DODO_TOPUP_PRODUCT_ID="pdt_..."
DODO_PRO_MONTHLY_CREDITS="10000"
DODO_TOPUP_CREDITS="5000"

# --- Desktop app download (set once you've built + hosted the Windows installer) ---
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=""
