generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  PRO_PLUS
  ULTRA
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ConversationMode {
  CHAT
  AGENT
}

enum ExecutionMode {
  CLOUD
  LOCAL
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())

  subscription   Subscription?
  conversations  Conversation[]
  creditLedger   CreditLedger[]
  sandboxSessions SandboxSession[]

  @@map("users")
}

model Subscription {
  id                        String              @id @default(cuid())
  userId                    String              @unique
  tier                      SubscriptionTier    @default(FREE)
  status                    SubscriptionStatus  @default(ACTIVE)
  currentPeriodEnd          DateTime?
  paymentProviderCustomerId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditLedger {
  id            String   @id @default(cuid())
  userId        String
  delta         Int
  reason        String
  relatedCallId String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_ledger")
}

model Conversation {
  id        String           @id @default(cuid())
  userId    String
  title     String           @default("New conversation")
  mode      ConversationMode @default(CHAT)
  executionMode ExecutionMode @default(CLOUD)
  createdAt DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  sandboxSession SandboxSession?

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  modelUsed      String?
  tokenCount     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ProcessedWebhookEvent {
  id          String   @id
  source      String
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_webhook_events")
}

model SandboxSession {
  id              String    @id @default(cuid())
  userId          String
  conversationId  String?   @unique
  externalId      String?   @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  creditsCharged  Int       @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sandbox_sessions")
}
